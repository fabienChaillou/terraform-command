// ── Integration tests — successful dispatch ───────────────────────────────────

func TestHandler_ValidPlan_Returns200(t *testing.T) {
	exec := successExecutor()
	h := newTestHandler(t, exec, nil)

	rr := postJSON(t, h, map[string]interface{}{
		"action": "plan",
		"args":   map[string]interface{}{"var": map[string]interface{}{"env": "prod"}},
	})

	if rr.Code != http.StatusOK {
		t.Fatalf("valid plan: status = %d, want 200 (body: %s)", rr.Code, rr.Body)
	}
	result := decodeResult(t, rr)
	if result.ExitCode != 0 {
		t.Errorf("ExitCode = %d, want 0", result.ExitCode)
	}
}

