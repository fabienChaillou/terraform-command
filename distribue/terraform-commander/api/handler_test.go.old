// TestHandler_TerraformNonZeroExit verifies that a non-zero terraform exit code
// is returned as HTTP 200 (the API call succeeded; terraform reported an error).
func TestHandler_TerraformNonZeroExit_IsStill200(t *testing.T) {
	h := newTestHandler(t, failedTerraformExecutor(), nil)

	rr := postJSON(t, h, map[string]interface{}{
		"action": "plan",
		"args":   map[string]interface{}{"no-color": true},
	})

	if rr.Code != http.StatusOK {
		t.Fatalf("non-zero exit should still be HTTP 200, got %d (body: %s)", rr.Code, rr.Body)
	}
	result := decodeResult(t, rr)
	if result.ExitCode == 0 {
		t.Error("ExitCode should be non-zero for a failed terraform command")
	}
}

// TestHandler_ExecutorError_Returns500 verifies that an infrastructure-level
// executor error (e.g. Temporal timeout) produces a 500 response.
func TestHandler_ExecutorError_Returns500(t *testing.T) {
	h := newTestHandler(t, errorExecutor(), nil)

	rr := postJSON(t, h, map[string]interface{}{
		"action": "plan",
		"args":   map[string]interface{}{"no-color": true},
	})

	if rr.Code != http.StatusInternalServerError {
		t.Errorf("executor error: status = %d, want 500 (body: %s)", rr.Code, rr.Body)
	}
}

// ── Integration tests — config forwarding ────────────────────────────────────

// TestHandler_CustomConfig_Timeouts checks that per-action timeouts from a
// custom config are correctly forwarded to the executor opts.
func TestHandler_CustomConfig_Timeouts(t *testing.T) {
	exec := successExecutor()
	cfg := &api.Config{
		TimeoutByAction: command.ActionMap[int]{
			"plan": 600,
		},
		MaxAttemptsByAction: command.ActionMap[int32]{
			"plan": 2,
		},
	}
	h := newTestHandler(t, exec, cfg)

	postJSON(t, h, map[string]interface{}{
		"action": "plan",
		"args":   map[string]interface{}{"no-color": true},
	})

	if exec.captured.opts.TimeoutSeconds != 600 {
		t.Errorf("plan timeout = %d, want 600", exec.captured.opts.TimeoutSeconds)
	}
	if exec.captured.opts.MaxAttempts != 2 {
		t.Errorf("plan MaxAttempts = %d, want 2", exec.captured.opts.MaxAttempts)
	}
}

// TestHandler_DefaultConfig_ApplyTimeout checks that the default config sets the
// expected timeout for apply (1800 s).
func TestHandler_DefaultConfig_ApplyTimeout(t *testing.T) {
	exec := successExecutor()
	h := newTestHandler(t, exec, nil) // nil → default config

	postJSON(t, h, map[string]interface{}{
		"action": "apply",
		"args":   map[string]interface{}{"auto-approve": true},
	})

	if exec.captured.opts.TimeoutSeconds != 1800 {
		t.Errorf("apply timeout = %d, want 1800", exec.captured.opts.TimeoutSeconds)
	}
}

// TestHandler_DefaultConfig_ApplyNoRetry ensures apply MaxAttempts = 1
// (non-idempotent command must never be retried automatically).
func TestHandler_DefaultConfig_ApplyNoRetry(t *testing.T) {
	exec := successExecutor()
	h := newTestHandler(t, exec, nil)

	postJSON(t, h, map[string]interface{}{
		"action": "apply",
		"args":   map[string]interface{}{"auto-approve": true},
	})

	if exec.captured.opts.MaxAttempts != 1 {
		t.Errorf("apply MaxAttempts = %d, want 1 (no retry for non-idempotent)", exec.captured.opts.MaxAttempts)
	}
}

// TestHandler_ActionForwardedInOpts checks that opts.Action is set to the
// request action so the executor can route to the right workflow.
func TestHandler_ActionForwardedInOpts(t *testing.T) {
	exec := successExecutor()
	h := newTestHandler(t, exec, nil)

	postJSON(t, h, map[string]interface{}{
		"action": "init",
		"args":   map[string]interface{}{"upgrade": true},
	})

	if exec.captured.opts.Action != "init" {
		t.Errorf("opts.Action = %q, want %q", exec.captured.opts.Action, "init")
	}
}

// TestHandler_ErrorResponse_ContainsDetail checks that validation error responses
// include the command's help text in the "detail" field.
func TestHandler_ErrorResponse_ContainsDetail(t *testing.T) {
	h := newTestHandler(t, successExecutor(), nil)
	rr := postJSON(t, h, map[string]interface{}{"action": "plan"})

	body := decodeError(t, rr)
	if _, ok := body["detail"]; !ok {
		t.Errorf("error response missing 'detail' field: %v", body)
	}
}

// ── Benchmarks ────────────────────────────────────────────────────────────────

func BenchmarkHandler_ValidPlan(b *testing.B) {
	h := newBenchHandler(b)
	body, _ := json.Marshal(map[string]interface{}{
		"action": "plan",
		"args":   map[string]interface{}{"var": map[string]interface{}{"env": "prod"}, "no-color": true},
	})

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest(http.MethodPost, "/terraform", bytes.NewReader(body))
		req.Header.Set("Content-Type", "application/json")
		rr := httptest.NewRecorder()
		h.ServeHTTP(rr, req)
		if rr.Code != http.StatusOK {
			b.Fatalf("unexpected status %d", rr.Code)
		}
	}
}

func BenchmarkHandler_ValidationError(b *testing.B) {
	h := newBenchHandler(b)
	body, _ := json.Marshal(map[string]interface{}{"action": "plan"})

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest(http.MethodPost, "/terraform", bytes.NewReader(body))
		req.Header.Set("Content-Type", "application/json")
		rr := httptest.NewRecorder()
		h.ServeHTTP(rr, req)
		if rr.Code != http.StatusUnprocessableEntity {
			b.Fatalf("unexpected status %d", rr.Code)
		}
	}
}

func BenchmarkHandler_UnknownAction(b *testing.B) {
	h := newBenchHandler(b)
	body, _ := json.Marshal(map[string]interface{}{"action": "fmt"})

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest(http.MethodPost, "/terraform", bytes.NewReader(body))
		req.Header.Set("Content-Type", "application/json")
		rr := httptest.NewRecorder()
		h.ServeHTTP(rr, req)
		if rr.Code != http.StatusBadRequest {
			b.Fatalf("unexpected status %d", rr.Code)
		}
	}
}

func BenchmarkHandler_Parallel_ValidPlan(b *testing.B) {
	h := newBenchHandler(b)
	body, _ := json.Marshal(map[string]interface{}{
		"action": "apply",
		"args":   map[string]interface{}{"auto-approve": true, "no-color": true},
	})

	b.ResetTimer()
	b.ReportAllocs()

	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			req := httptest.NewRequest(http.MethodPost, "/terraform", bytes.NewReader(body))
			req.Header.Set("Content-Type", "application/json")
			rr := httptest.NewRecorder()
			h.ServeHTTP(rr, req)
			if rr.Code != http.StatusOK {
				b.Fatalf("unexpected status %d", rr.Code)
			}
		}
	})
}

func BenchmarkHandler_Parallel_MixedLoad(b *testing.B) {
	h := newBenchHandler(b)

	payloads := [][]byte{
		mustMarshal(map[string]interface{}{
			"action": "plan",
			"args":   map[string]interface{}{"var": map[string]interface{}{"env": "prod"}},
		}),
		mustMarshal(map[string]interface{}{
			"action": "apply",
			"args":   map[string]interface{}{"auto-approve": true},
		}),
		mustMarshal(map[string]interface{}{
			"action": "init",
			"args":   map[string]interface{}{"upgrade": true},
		}),
		mustMarshal(map[string]interface{}{"action": "plan"}), // validation error
		mustMarshal(map[string]interface{}{"action": "fmt"}),  // unknown action
	}

	b.ResetTimer()
	b.ReportAllocs()

	var counter int64
	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			idx := int(atomic.AddInt64(&counter, 1)) % len(payloads)
			body := payloads[idx]
			req := httptest.NewRequest(http.MethodPost, "/terraform", bytes.NewReader(body))
			req.Header.Set("Content-Type", "application/json")
			rr := httptest.NewRecorder()
			h.ServeHTTP(rr, req)
			_ = rr.Code
		}
	})
}

// ── bench helpers ─────────────────────────────────────────────────────────────

func newBenchHandler(tb testing.TB) http.Handler {
	tb.Helper()
	r := chi.NewRouter()
	humaAPI := humachi.New(r, huma.DefaultConfig("Bench API", "1.0.0"))
	exec := &mockExecutor{
		result: &command.ExecutionResult{ExitCode: 0, Stdout: "ok"},
	}
	api.RegisterRoutes(humaAPI, command.NewRegistry(), exec, nil)
	return r
}

func mustMarshal(v interface{}) []byte {
	b, err := json.Marshal(v)
	if err != nil {
		panic(err)
	}
	return b
}
