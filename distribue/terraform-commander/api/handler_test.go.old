// Package api_test contains integration tests and benchmarks for the
// POST /terraform handler.
//
// Tests exercise the full HTTP pipeline: JSON decoding → validation →
// executor dispatch → JSON encoding, using a real Huma+Chi router wired
// with a mock Executor so no Temporal connection is required.
package api_test

import (
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"net/http"
	"net/http/httptest"
	"sync/atomic"
	"testing"

	"github.com/danielgtaylor/huma/v2"
	"github.com/danielgtaylor/huma/v2/humachi"
	"github.com/go-chi/chi/v5"

	"github.com/fabienChaillou/terraform-commander/api"
	"github.com/fabienChaillou/terraform-commander/command"
)

// ── Test double ───────────────────────────────────────────────────────────────

// mockExecutor is a configurable test double for api.Executor.
// The binary is absent because it is now fixed by TerraformBinary in the activity.
type mockExecutor struct {
	result *command.ExecutionResult
	err    error
	// captured lets tests inspect what was forwarded to the worker.
	captured struct {
		args []string
		opts command.ExecuteOptions
	}
}

func (m *mockExecutor) Execute(
	ctx context.Context,
	args []string,
	opts command.ExecuteOptions,
) (*command.ExecutionResult, error) {
	m.captured.args = args
	m.captured.opts = opts
	return m.result, m.err
}

// successExecutor returns exit code 0 with fixed stdout.
func successExecutor() *mockExecutor {
	return &mockExecutor{
		result: &command.ExecutionResult{ExitCode: 0, Stdout: "Plan: 3 to add, 0 to change, 0 to destroy.\n"},
	}
}

// failedTerraformExecutor returns exit code 1 (terraform error, not a Go error).
func failedTerraformExecutor() *mockExecutor {
	return &mockExecutor{
		result: &command.ExecutionResult{ExitCode: 1, Stderr: "Error: no configuration files"},
	}
}

// errorExecutor simulates a worker infrastructure failure (Go error).
func errorExecutor() *mockExecutor {
	return &mockExecutor{err: errors.New("temporal: workflow execution timed out")}
}

// ── Router factory ────────────────────────────────────────────────────────────

func newTestHandler(t *testing.T, exec api.Executor, cfg *api.Config) http.Handler {
	t.Helper()
	r := chi.NewRouter()
	humaAPI := humachi.New(r, huma.DefaultConfig("Test API", "1.0.0"))
	api.RegisterRoutes(humaAPI, command.NewRegistry(), exec, cfg)
	return r
}

// ── HTTP helpers ──────────────────────────────────────────────────────────────

func postJSON(t *testing.T, handler http.Handler, body interface{}) *httptest.ResponseRecorder {
	t.Helper()
	b, err := json.Marshal(body)
	if err != nil {
		t.Fatalf("json.Marshal: %v", err)
	}
	req := httptest.NewRequest(http.MethodPost, "/terraform", bytes.NewReader(b))
	req.Header.Set("Content-Type", "application/json")
	rr := httptest.NewRecorder()
	handler.ServeHTTP(rr, req)
	return rr
}

// decodeResult parses the response body into an ExecutionResult.
func decodeResult(t *testing.T, rr *httptest.ResponseRecorder) *command.ExecutionResult {
	t.Helper()
	var result command.ExecutionResult
	if err := json.NewDecoder(rr.Body).Decode(&result); err != nil {
		t.Fatalf("decode ExecutionResult: %v (body: %s)", err, rr.Body.String())
	}
	return &result
}

// decodeError parses the RFC 9457 Problem Details error response.
func decodeError(t *testing.T, rr *httptest.ResponseRecorder) map[string]interface{} {
	t.Helper()
	var body map[string]interface{}
	if err := json.NewDecoder(rr.Body).Decode(&body); err != nil {
		t.Fatalf("decode error body: %v (raw: %s)", err, rr.Body.String())
	}
	return body
}

// ── Integration tests — routing & status codes ────────────────────────────────

func TestHandler_UnknownAction_Returns400(t *testing.T) {
	h := newTestHandler(t, successExecutor(), nil)
	rr := postJSON(t, h, map[string]interface{}{"action": "validate"})

	if rr.Code != http.StatusBadRequest {
		t.Errorf("status = %d, want %d (body: %s)", rr.Code, http.StatusBadRequest, rr.Body)
	}
}

func TestHandler_EmptyAction_Returns400(t *testing.T) {
	h := newTestHandler(t, successExecutor(), nil)
	rr := postJSON(t, h, map[string]interface{}{"action": ""})

	if rr.Code != http.StatusBadRequest {
		t.Errorf("status = %d, want %d", rr.Code, http.StatusBadRequest)
	}
}

func TestHandler_MissingBody_Returns422(t *testing.T) {
	h := newTestHandler(t, successExecutor(), nil)
	req := httptest.NewRequest(http.MethodPost, "/terraform", bytes.NewReader([]byte("{}")))
	req.Header.Set("Content-Type", "application/json")
	rr := httptest.NewRecorder()
	h.ServeHTTP(rr, req)

	if rr.Code != http.StatusUnprocessableEntity && rr.Code != http.StatusBadRequest {
		t.Errorf("empty body: status = %d, want 400 or 422", rr.Code)
	}
}

